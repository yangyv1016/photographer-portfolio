# 私有 COS / 轻量对象存储；填写自己的桶、地域和最小权限凭据。
STORAGE_BACKEND=cos
PUBLIC_ORIGIN=http://127.0.0.1:8080
PORT=8080
DATA_DIRECTORY=data
COS_BUCKET=YOUR_BUCKET
COS_REGION=YOUR_REGION
COS_SECRET_ID=
COS_SECRET_KEY=

# 可选：爱发电固定领取链接 /claim；不启用时保持为空。
# 方案、签名查单、密钥备份见 docs/SUBSCRIPTIONS.md。
AFDIAN_USER_ID=
AFDIAN_API_TOKEN=
AFDIAN_DELIVERY_KEY=
AFDIAN_MONTHLY_PLAN_ID=
AFDIAN_QUARTERLY_PLAN_ID=
AFDIAN_YEARLY_PLAN_ID=
