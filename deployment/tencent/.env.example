# 服务器本地磁盘存储；无需 COS 账号、桶或密钥。
STORAGE_BACKEND=local
PUBLIC_ORIGIN=http://127.0.0.1:8080
PORT=8080
DATA_DIRECTORY=data

# 可选：爱发电固定领取链接 /claim；不启用时保持为空。
# 方案、签名查单、密钥备份见 docs/SUBSCRIPTIONS.md。
AFDIAN_USER_ID=
AFDIAN_API_TOKEN=
AFDIAN_DELIVERY_KEY=
AFDIAN_MONTHLY_PLAN_ID=
AFDIAN_QUARTERLY_PLAN_ID=
AFDIAN_YEARLY_PLAN_ID=
