[Unit]
Description=Back up Yangyu SQLite catalog
After=yangyu.service

[Service]
Type=oneshot
User=yangyu
Group=yangyu
WorkingDirectory=/opt/yangyu/current
EnvironmentFile=/etc/yangyu.env
Environment=DATA_DIRECTORY=/var/lib/yangyu
ExecStart=/opt/yangyu-runtime/node/bin/node app/backup.mjs
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/yangyu
